# 辫子哥代账系统后端配置样例：复制为 server/.env 后按需修改（.env 已 gitignore）

# 服务端口（nginx 反代目标；本机默认 3000）
PORT=3000

# SQLite 数据目录 与 上传文件目录（默认 server/data、server/uploads）
# DATA_DIR=/var/www/zc-server/data
# UPLOAD_DIR=/var/www/zc-server/uploads

# JWT 签名密钥：留空则首次启动自动生成并入库持久化；多实例部署务必显式配置同一个值
# JWT_SECRET=change-me-to-a-long-random-string

# 首次启动自动创建的管理员账号（仅在用户表为空时创建；上线后请立即改密）
ADMIN_USER=boss
ADMIN_PASS=bianzige2026

# AI 代理（Key 只存服务器，不下发浏览器）
AI_API_KEY=
# 端点白名单按键选择：zhipu / deepseek / tongyi / kimi / doubao / hunyuan / qianfan
AI_ENDPOINT=zhipu
# 默认模型（请求未指定 model 时使用）
AI_MODEL=glm-4-flash
